# ADLAS Platform Environment Configuration
# Project: adlas-core

# System & Application
PROJECT_NAME="adlas-core"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="replace-with-a-secure-secret-key-in-production"

# Network & Ports
KONG_HTTP_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=5173
ADMIN_CONSOLE_PORT=5174

# Database Connection (Supabase Cloud PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password_here
POSTGRES_HOST=db.[YOUR-PROJECT-REF].supabase.co
POSTGRES_PORT=5432

# Supabase Cloud Client & Auth
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Security & Tokens
JWT_SECRET=replace-with-a-secure-jwt-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Artificial Intelligence Gateway (Google Gemini API - 0MB Host RAM)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Object Storage Bucket Configuration
STORAGE_BUCKET_MATERIALS=materials
STORAGE_BUCKET_SUBMISSIONS=submissions

# Repomix Container Microservice
REPOMIX_SERVICE_URL=http://repomix:3000

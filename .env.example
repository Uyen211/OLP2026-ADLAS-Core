# Environment Variables Configuration
# Copy this file to .env and adjust values for your local environment

# System
PROJECT_NAME="ADLAS Core"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"

# Network & Ports
KONG_HTTP_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=5173
ADMIN_CONSOLE_PORT=5174

# Database (PostgreSQL 16)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=adlas_db
POSTGRES_USER=adlas_admin
POSTGRES_PASSWORD=adlas_secure_password
DATABASE_URL=postgresql+asyncpg://adlas_admin:adlas_secure_password@localhost:5432/adlas_db

# Object Storage (MinIO S3 Compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_password
MINIO_BUCKET_MATERIALS=adlas-materials
MINIO_BUCKET_SUBMISSIONS=adlas-submissions

# Identity & Security (Supabase GoTrue / JWT)
JWT_SECRET=adlas-default-jwt-secret-key-super-secure-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Studio Dashboard
SUPABASE_STUDIO_PORT=54323

# Artificial Intelligence Gateway (Dual-Mode: Cloud Gemini vs Local Ollama)
# Options: "gemini" (Default: 0MB RAM, high speed) | "ollama" (Offline mode)
AI_PROVIDER=gemini

# Google Gemini API Configuration (Default for development)
# Obtain a free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
